  aktif       Boolean  @default(true)
  olusturuldu DateTime @default(now())

  @@map("yayinlar")
}

enum OdemeDurumu {
  BEKLEMEDE
  TAMAMLANDI
  IPTAL_EDILDI
  IADE_EDILDI
  HATA
}

model SatinAlim {
  id              String      @id @default(cuid())
  kullaniciId     String
  paketId         String?
  sinavId         String?
  /// Öğrencinin bağlı olduğu koç (yönlendirme / paket satışı atribüsyonu)
  kocProfilId     String?
  miktar          Float
  indirimMiktari  Float       @default(0)
  toplamTutar     Float       @default(0) // miktar + vergi vb.
  durum           OdemeDurumu @default(BEKLEMEDE)
  referansNo      String?     @unique // Ödeme sağlayıcısı (örn: iyzico) ID
  odemeMetodu     String?     @default("KREDİ KARTI") // KREDİ KARTI, HAVALE, MANUEL
  notlar          String?
  ipAdresi        String?
  faturaBilgileri Json? // { "ad": "...", "vergiDairesi": "...", ... }

  olusturuldu DateTime  @default(now())
  odemeZamani DateTime?
  guncellendi DateTime  @updatedAt

  kullanici            Kullanici             @relation(fields: [kullaniciId], references: [id])
  paket                Paket?                @relation(fields: [paketId], references: [id])
  sinav                Sinav?                @relation(fields: [sinavId], references: [id])
  kocProfil            KocProfil?            @relation(fields: [kocProfilId], references: [id], onDelete: SetNull)
  sinavAtamalari       OgrenciSinavAtama[]
  IndirimKoduKullanimi IndirimKoduKullanimi?

  @@index([sinavId, durum])
  @@index([kocProfilId, durum])
  @@map("satin_alimlar")
}

// ============================================
// İNDİRİM KODU & ÖĞRETMEN KOMİSYONU
// ============================================

enum IndirimTipi {
  YUZDE
  TUTAR
}

enum KomisyonDurumu {
  /// Satın alma henüz tamamlanmadı
  BEKLEMEDE
  /// Ödeme tamamlandı, hakediş kesinleşti
  ONAYLANDI
  /// Öğretmene ödendi
  ODENDI
  /// Sipariş iptal / iade edildi
  IPTAL
}

enum IndirimPlatformu {
  HEPSI
  YKS_LGS
  KPSS
}

/// Öğrencinin ödemede girdiği indirim kodu; sahibi öğretmene komisyon kazandırır
model IndirimKodu {
  id              String           @id @default(cuid())
  kod             String           @unique
  aciklama        String?
  /// Komisyonun yazılacağı öğretmen (boşsa yalnızca indirim kodu)
  ogretmenId      String?
  indirimTipi     IndirimTipi      @default(YUZDE)
  indirimDegeri   Float
  komisyonTipi    IndirimTipi      @default(YUZDE)
  /// Öğretmenin hak edeceği oran/tutar (net tutar üzerinden)
  komisyonDegeri  Float            @default(0)
  platform        IndirimPlatformu @default(HEPSI)
  aktif           Boolean          @default(true)
  baslangic       DateTime?
  bitis           DateTime?
  /// Toplam kullanım sınırı (boşsa sınırsız)
  maksKullanim    Int?
  /// Aynı öğrencinin kaç kez kullanabileceği
  kullaniciLimiti Int?             @default(1)
  minTutar        Float?
  kullanimSayisi  Int              @default(0)
  olusturuldu     DateTime         @default(now())
  guncellendi     DateTime         @updatedAt

  ogretmen    Kullanici?             @relation("IndirimKoduOgretmen", fields: [ogretmenId], references: [id], onDelete: SetNull)
  kullanimlar IndirimKoduKullanimi[]

  @@index([aktif, kod])
  @@index([ogretmenId])
  @@map("indirim_kodlari")
}

/// Bir siparişte kullanılan indirim kodu ve doğan öğretmen komisyonu
model IndirimKoduKullanimi {
  id             String         @id @default(cuid())
  kodId          String
  kullaniciId    String
  satinAlimId    String         @unique
  ogretmenId     String?
  brutTutar      Float
  indirimTutari  Float
  netTutar       Float
  komisyonTutari Float          @default(0)
  komisyonDurumu KomisyonDurumu @default(BEKLEMEDE)
  odemeTarihi    DateTime?
  odemeNotu      String?
  olusturuldu    DateTime       @default(now())
  guncellendi    DateTime       @updatedAt

  kod       IndirimKodu @relation(fields: [kodId], references: [id], onDelete: Cascade)
  kullanici Kullanici   @relation("IndirimKullanan", fields: [kullaniciId], references: [id], onDelete: Cascade)
  ogretmen  Kullanici?  @relation("IndirimKomisyonOgretmeni", fields: [ogretmenId], references: [id], onDelete: SetNull)
  satinAlim SatinAlim   @relation(fields: [satinAlimId], references: [id], onDelete: Cascade)

  @@index([ogretmenId, komisyonDurumu])
  @@index([kodId])
  @@index([olusturuldu(sort: Desc)])
  @@map("indirim_kodu_kullanimlari")
}

// ============================================
// SİTE (LANDİNG) İÇERİĞİ — TEK SATIR
// ============================================

model SiteGenelIcerik {
